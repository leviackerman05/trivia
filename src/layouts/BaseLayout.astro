---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import Icon from '../components/icons/Icon.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogImage?: string;
  jsonLd?: string;
  /** Wide layout (max-w-7xl) for game pages so the play area gets more room. */
  wide?: boolean;
  /** Active nav section for aria-current, e.g. "daily" | "games" | "categories". */
  activeNav?: string;
}

const { title, description, canonicalPath, ogImage, jsonLd, wide = false, activeNav } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home', key: 'home' },
  { href: '/daily', label: 'Daily Games', key: 'daily' },
  { href: '/#games', label: 'Games', key: 'games' },
  { href: '/categories', label: 'Categories', key: 'categories' },
  { href: '/#multiplayer', label: 'Multiplayer', key: 'multiplayer' },
];

/* Bottom tab bar (mobile): the five destinations that matter on a phone. */
const tabBar = [
  { href: '/', label: 'Home', emoji: '🏠', key: 'home' },
  { href: '/daily', label: 'Daily', emoji: '🎯', key: 'daily' },
  { href: '/#games', label: 'Games', emoji: '🎮', key: 'games' },
  { href: '/categories', label: 'Categories', emoji: '🗂', key: 'categories' },
  { href: '/#multiplayer', label: 'Play', emoji: '👥', key: 'multiplayer' },
];

const footerLinks = [
  { href: '/daily', label: 'Daily Games' },
  { href: '/categories', label: 'Categories' },
  { href: '/privacy-policy', label: 'Privacy Policy' },
  { href: '/terms-and-conditions', label: 'Terms & Conditions' },
  { href: '/about-us', label: 'About Us' },
  { href: '/contact-us', label: 'Contact Us' },
  { href: '/faq', label: 'FAQ' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImage={ogImage}
      jsonLd={jsonLd}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Theme (light-first per the Airbnb direction, OWNER d2): the dark
         theme is an explicit .dark class; localStorage overrides the
         default; the header toggle calls window.__pbTheme(). -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('pb-theme');
          const dark = stored === 'dark';
          document.documentElement.classList.toggle('dark', dark);
        } catch {
          /* storage blocked, light default */
        }
        window.__pbTheme = function () {
          const html = document.documentElement;
          const next = html.classList.contains('dark');
          html.classList.toggle('dark', !next);
          try {
            localStorage.setItem('pb-theme', next ? 'light' : 'dark');
          } catch {
            /* storage blocked, session-only toggle */
          }
        };
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-surface font-body text-body text-ink">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-primary focus:px-5 focus:py-3 focus:font-semibold focus:text-white"
    >
      Skip to main content
    </a>
    <header class="sticky top-0 z-20 border-b border-border bg-surface-raised/95 backdrop-blur">
      <nav
        class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3"
        aria-label="Main"
      >
        <a href="/" class="flex items-center gap-2 text-lg font-extrabold tracking-tight text-ink">
          <img src="/favicon.svg" alt="" width="28" height="28" class="h-7 w-7" />
          Trivia in <span class="text-primary-deep">Games</span>
        </a>
        <ul class="hidden items-center gap-1 lg:flex">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={activeNav === link.key ? 'page' : undefined}
                  class="rounded-md px-3 py-2 text-small font-medium text-ink-muted transition-colors hover:bg-surface-muted hover:text-ink aria-current:bg-surface-muted aria-current:text-ink"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <button
          type="button"
          onclick="window.__pbTheme && window.__pbTheme()"
          aria-label="Toggle theme"
          class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-border bg-surface-muted text-base transition-colors hover:border-primary/50"
        >
          <span class="dark:hidden" aria-hidden="true">
            <Icon name="moon" size={18} />
          </span>
          <span class="hidden dark:inline" aria-hidden="true">
            <Icon name="sun" size={18} />
          </span>
        </button>
      </nav>
    </header>

    <main
      id="main-content"
      class:list={[
        'mx-auto w-full flex-1 px-4 pb-24 pt-6 md:pb-12 md:pt-10',
        // [AIRBNB d9] ~1280px content cap site-wide (was 1152 editorial).
        wide ? 'max-w-7xl' : 'max-w-7xl',
      ]}
    >
      <slot />
    </main>

    <footer class="border-t border-border bg-surface-raised">
      <div
        class="mx-auto flex max-w-7xl flex-col items-center gap-4 px-4 py-8 sm:flex-row sm:justify-between"
      >
        <p class="text-small text-ink-muted">
          © 2026 Trivia in Games. Free party games, daily trivia, multiplayer fun.
        </p>
        <ul class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
          {
            footerLinks.map((link) => (
              <li>
                <a href={link.href} class="text-small text-ink-muted hover:text-primary-strong">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </footer>

    <!-- Mobile tab bar: fixed, safe-area aware, hidden from lg up. -->
    <nav
      aria-label="Mobile"
      class="fixed inset-x-0 bottom-0 z-20 border-t border-border bg-surface-raised/95 pb-[env(safe-area-inset-bottom)] backdrop-blur lg:hidden"
    >
      <ul class="grid grid-cols-5">
        {
          tabBar.map((tab) => (
            <li>
              <a
                href={tab.href}
                aria-current={activeNav === tab.key ? 'page' : undefined}
                class="flex min-h-14 flex-col items-center justify-center gap-0.5 text-xs font-medium text-ink-muted transition-colors aria-current:text-primary-deep"
              >
                <span aria-hidden="true" class="text-base">
                  {tab.emoji}
                </span>
                {tab.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </body>
</html>
