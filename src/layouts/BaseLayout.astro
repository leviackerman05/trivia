---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogImage?: string;
  jsonLd?: string;
  /** Wide layout (max-w-7xl) for game pages so the play area gets more room. */
  wide?: boolean;
  /** Active nav section for aria-current, e.g. "daily" | "games" | "categories". */
  activeNav?: string;
}

const { title, description, canonicalPath, ogImage, jsonLd, wide = false, activeNav } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home', key: 'home' },
  { href: '/daily', label: 'Daily Games', key: 'daily' },
  { href: '/#games', label: 'Games', key: 'games' },
  { href: '/categories', label: 'Categories', key: 'categories' },
  { href: '/#multiplayer', label: 'Multiplayer', key: 'multiplayer' },
  { href: '/#new-games', label: 'New Games', key: 'new' },
  { href: '/#trending', label: 'Trending', key: 'trending' },
];

const footerLinks = [
  { href: '/daily', label: 'Daily Games' },
  { href: '/categories', label: 'Categories' },
  { href: '/privacy-policy', label: 'Privacy Policy' },
  { href: '/terms-and-conditions', label: 'Terms & Conditions' },
  { href: '/about-us', label: 'About Us' },
  { href: '/contact-us', label: 'Contact Us' },
  { href: '/faq', label: 'FAQ' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImage={ogImage}
      jsonLd={jsonLd}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Theme (M12): apply before paint (no FOUC); localStorage overrides the
         system preference; the header toggle calls window.__pbTheme(). -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('pb-theme');
          const dark =
            stored === 'dark' ||
            (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', dark);
        } catch {
          /* storage blocked, system preference only */
        }
        window.__pbTheme = function () {
          const html = document.documentElement;
          const next = html.classList.contains('dark') ? 'light' : 'dark';
          html.classList.toggle('dark', next === 'dark');
          try {
            localStorage.setItem('pb-theme', next);
          } catch {
            /* storage blocked, session-only toggle */
          }
        };
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-surface font-body text-body text-ink">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-pill focus:bg-primary-strong focus:px-5 focus:py-3 focus:font-semibold focus:text-white"
    >
      Skip to main content
    </a>
    <header
      class="sticky top-0 z-10 border-b-2 border-dashed border-border bg-surface-raised/95 backdrop-blur"
    >
      <nav
        class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-3"
        aria-label="Main"
      >
        <a href="/" class="flex items-center gap-2 font-display text-2xl text-primary-strong">
          <img src="/favicon.svg" alt="" width="32" height="32" class="h-8 w-8 rounded-lg" />
          TriviaHub
        </a>
        <ul class="flex flex-wrap items-center gap-x-5 gap-y-1">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={activeNav === link.key ? 'page' : undefined}
                  class="text-small font-medium text-ink-muted transition-colors hover:text-primary-strong"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <button
              type="button"
              onclick="window.__pbTheme && window.__pbTheme()"
              aria-label="Toggle dark mode"
              class="inline-flex h-10 w-10 items-center justify-center rounded-pill border-2 border-border bg-surface-muted text-lg transition-colors hover:border-primary/50"
            >
              <span class="dark:hidden" aria-hidden="true">🌙</span>
              <span class="hidden dark:inline" aria-hidden="true">☀️</span>
            </button>
          </li>
        </ul>
      </nav>
    </header>

    <main
      id="main-content"
      class:list={['mx-auto w-full flex-1 px-4 py-10', wide ? 'max-w-7xl' : 'max-w-6xl']}
    >
      <slot />
    </main>

    <footer class="border-t-2 border-dashed border-border bg-surface-raised">
      <div
        class="mx-auto flex max-w-7xl flex-col items-center gap-4 px-4 py-8 sm:flex-row sm:justify-between"
      >
        <p class="text-small text-ink-muted">
          © 2026 TriviaHub. Free party games, daily trivia, multiplayer fun.
        </p>
        <ul class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
          {
            footerLinks.map((link) => (
              <li>
                <a href={link.href} class="text-small text-ink-muted hover:text-primary-strong">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </footer>
  </body>
</html>
