---
interface Props {
  title: string;
  description: string;
  /** Absolute path starting with "/", canonical + OG URLs resolve against the site base. */
  canonicalPath: string;
  /** Optional OG image path (absolute). Generated by scripts/generate-og.mjs. */
  ogImage?: string;
  /** Optional JSON-LD structured data (stringified). */
  jsonLd?: string;
}

const { title, description, canonicalPath, ogImage, jsonLd } = Astro.props;
const site = Astro.site ?? new URL('https://playtriviahub.com');
const canonical = new URL(canonicalPath, site);
const ogImageUrl = ogImage ? new URL(ogImage, site) : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="theme-color" content="#ff385c" />
<link rel="manifest" href="/site.webmanifest" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Trivia & Games" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
{ogImageUrl && <meta property="og:image:width" content="1200" />}
{ogImageUrl && <meta property="og:image:height" content="630" />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

{jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
