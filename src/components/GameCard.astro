---
import type { Game } from '../lib/games';
import Badge from './ui/Badge.astro';

/**
 * GameCard: catalog tile with discovery metadata (players, duration,
 * energy), family chip, and New/Featured badges. One accessible link.
 */
interface Props {
  game: Game;
}

const { game } = Astro.props;
const energyLabel = game.energy === 'high' ? 'High energy' : 'Low energy';
---

<a
  href={`/game/${game.slug}`}
  class="group flex h-full flex-col gap-3 rounded-lg border-2 border-border bg-surface-raised p-6 shadow-sm transition-all duration-150 hover:-translate-y-0.5 hover:border-secondary hover:shadow-md"
>
  <span class="flex items-start justify-between gap-3">
    <h3 class="font-display text-h3 text-ink group-hover:text-primary-strong">{game.name}</h3>
    <span class="flex shrink-0 flex-wrap justify-end gap-1.5">
      {game.isNew && <Badge tone="success">New</Badge>}
      {game.featured && <Badge tone="warning">Popular</Badge>}
    </span>
  </span>
  <p class="text-body text-ink-muted">{game.tagline}</p>
  <span
    class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs font-medium text-ink-muted"
  >
    <span>👥 {game.players ?? 'Any'}</span>
    {game.durationMinutes && <span>⏱ {game.durationMinutes} min</span>}
    <span>⚡ {energyLabel}</span>
  </span>
  <span
    class="w-fit rounded-pill border-2 border-primary/40 bg-primary/20 px-4 py-1 text-xs font-semibold uppercase tracking-wide text-primary-deep"
  >
    {game.family}
  </span>
</a>
