---
import type { Game } from '../lib/games';

interface Props {
  game: Game;
}

const { game } = Astro.props;
---

<a
  href={`/game/${game.slug}`}
  class="flex h-full flex-col gap-3 rounded-lg border-2 border-border bg-surface-raised p-6 shadow-sm transition-colors hover:border-secondary hover:shadow-md"
>
  <h2 class="font-display text-h3 text-ink">{game.name}</h2>
  <p class="text-body text-ink-muted">{game.tagline}</p>
  <span
    class="mt-auto w-fit rounded-pill border-2 border-primary/40 bg-primary/20 px-4 py-1 text-xs font-semibold uppercase tracking-wide text-primary-deep"
  >
    {game.family}
  </span>
</a>
