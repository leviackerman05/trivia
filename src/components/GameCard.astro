---
import type { Game } from '../lib/games';
import Badge from './ui/Badge.astro';

/**
 * GameCard: catalog tile with discovery metadata (players, duration,
 * energy) and New/Featured badges. One accessible link.
 * [§5.3] Airbnb hover: 1px hairline border + the single hover-float shadow
 * (no translate, no border-color shift); title 16/600 ink. Chrome icons
 * are in-repo SVGs, never emojis. The family chip is omitted: both
 * consumers (homepage, /games) render cards inside family-grouped sections,
 * so the chip would only repeat the heading ([D067] PRD §10 weight gate).
 */
interface Props {
  game: Game;
}

const { game } = Astro.props;
const energyLabel = game.energy === 'high' ? 'High energy' : 'Low energy';
const badges = [
  ...(game.isNew ? [{ tone: 'success' as const, label: 'New' }] : []),
  ...(game.featured ? [{ tone: 'warning' as const, label: 'Popular' }] : []),
];
---

<a
  href={`/game/${game.slug}`}
  class="group flex h-full flex-col gap-3 rounded-lg border border-border bg-surface-raised p-4 shadow-sm transition-shadow duration-150 hover:shadow-md sm:p-6"
>
  <span class="flex items-start justify-between gap-3">
    <h3 class="text-base font-semibold text-ink group-hover:text-primary-strong">
      {game.name}
    </h3>
    {
      badges.length > 0 && (
        <span class="flex shrink-0 flex-wrap justify-end gap-1.5">
          {badges.map((badge) => (
            <Badge tone={badge.tone}>{badge.label}</Badge>
          ))}
        </span>
      )
    }
  </span>
  <p class="text-small text-ink-muted">{game.tagline}</p>
  <span
    class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs font-medium text-ink-muted"
  >
    <span class="inline-flex items-center gap-1">
      {game.players ?? 'Any'}
    </span>
    {
      game.durationMinutes && (
        <span class="inline-flex items-center gap-1">{game.durationMinutes} min</span>
      )
    }
    <span class="inline-flex items-center gap-1">{energyLabel}</span>
  </span>
</a>
