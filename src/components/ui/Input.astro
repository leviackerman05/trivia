---
/** Input types Trivia in Games uses (subset of React's HTMLInputTypeAttribute). */
type InputType = 'text' | 'email' | 'password' | 'number' | 'search' | 'tel' | 'url';

/**
 * Trivia in Games Input ([AIRBNB] text-input + OWNER d7): white surface, 8px
 * radius, 1px hairline outline; focus flips to a 2px ink indicator with no
 * glow (ring-ink); error state keeps the status red border + helper.
 */
interface Props {
  id: string;
  name?: string;
  label?: string;
  type?: InputType;
  value?: string;
  placeholder?: string;
  helper?: string;
  error?: string;
  disabled?: boolean;
  required?: boolean;
  class?: string;
}

const {
  id,
  name = id,
  label,
  type = 'text',
  value,
  placeholder,
  helper,
  error,
  disabled,
  required,
  class: className,
} = Astro.props;
---

<div class={`flex flex-col ${className ?? ''}`}>
  {
    label && (
      <label for={id} class="mb-1.5 text-small font-semibold text-ink">
        {label}
      </label>
    )
  }
  <input
    id={id}
    name={name}
    type={type}
    value={value}
    placeholder={placeholder}
    disabled={disabled}
    required={required}
    aria-invalid={error ? true : undefined}
    aria-describedby={error ? `${id}-error` : helper ? `${id}-helper` : undefined}
    class={`rounded-md border bg-surface-raised px-4 py-3 text-base text-ink transition-colors focus:ring-2 ${
      error
        ? 'border-danger bg-danger-soft focus:border-danger focus:ring-danger/40'
        : 'border-border hover:border-border-strong focus:ring-ink'
    } ${disabled ? 'opacity-50 disabled:cursor-not-allowed' : ''}`}
  />
  {
    helper && !error && (
      <p id={`${id}-helper`} class="mt-1.5 text-xs text-ink-muted">
        {helper}
      </p>
    )
  }
  {
    error && (
      <p id={`${id}-error`} class="mt-1.5 text-xs text-error">
        {error}
      </p>
    )
  }
</div>
