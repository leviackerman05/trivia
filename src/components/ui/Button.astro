---
/**
 * Trivia & Games Button (Airbnb direction, OWNER d1/d5): Rausch primary with
 * white text and 8px radius; ink-outline secondary; ghost and destructive
 * variants. ≥44px touch targets (min-h-11+). Renders an <a> when href is
 * provided, otherwise a <button>.
 */
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'destructive';
  size?: 'small' | 'medium' | 'large';
  href?: string;
  type?: 'button' | 'submit';
  disabled?: boolean;
  class?: string;
}

const {
  variant = 'primary',
  size = 'medium',
  href,
  type = 'button',
  disabled = false,
  class: className,
} = Astro.props;

const variants: Record<NonNullable<Props['variant']>, string> = {
  primary: 'bg-primary text-white hover:bg-primary-hover disabled:bg-primary-disabled',
  // [AIRBNB] button-secondary: white fill, ink text, 1px ink outline.
  secondary: 'border border-ink bg-surface-raised text-ink hover:bg-surface-muted',
  ghost: 'border border-primary-strong text-primary-strong hover:bg-primary/15',
  destructive: 'bg-danger-strong text-white hover:opacity-90',
};

const sizes: Record<NonNullable<Props['size']>, string> = {
  small: 'min-h-11 px-5 py-2.5 text-small',
  medium: 'min-h-12 px-6 py-3 text-body',
  large: 'min-h-14 px-8 py-4 text-lg',
};

// [AIRBNB] buttons are 8px radius (rounded-md), label weight 500.
const base =
  'inline-flex items-center justify-center gap-2 rounded-md font-medium no-underline transition-colors duration-150 select-none';
const disabledClasses = disabled ? 'pointer-events-none opacity-40' : '';
---

{
  href && (
    <a
      href={href}
      aria-disabled={disabled || undefined}
      class={`${base} ${variants[variant]} ${sizes[size]} ${disabledClasses} ${className ?? ''}`}
    >
      <slot />
    </a>
  )
}
{
  !href && (
    <button
      type={type}
      disabled={disabled}
      class={`${base} ${variants[variant]} ${sizes[size]} ${disabledClasses} ${className ?? ''}`}
    >
      <slot />
    </button>
  )
}
