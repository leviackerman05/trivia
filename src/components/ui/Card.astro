---
/**
 * Card ([AIRBNB] d5/d8): white surface, 14px radius (rounded-lg), hairline
 * border + 1px inset hairline ring at rest (shadow-sm), and the single
 * hover-float shadow on hover (shadow-md). No progressive elevation tiers.
 */
interface Props {
  elevated?: boolean;
  hover?: boolean;
  class?: string;
}

const { elevated = false, hover = true, class: className } = Astro.props;

const surface = 'rounded-lg bg-surface-raised p-4 sm:p-6';
// Flat baseline: hairline border + inset hairline ring; hover = the float.
const defaultCard = 'border border-border shadow-sm';
const elevatedCard = 'border border-border shadow-sm';
const hoverClasses = hover ? 'transition-all duration-150 hover:shadow-md' : '';
const hoverBorder = elevated ? '' : '';
---

<div
  class={`${surface} ${elevated ? elevatedCard : defaultCard} ${hoverClasses} ${hoverBorder} ${className ?? ''}`}
>
  <slot />
</div>
