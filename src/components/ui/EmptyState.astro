---
/**
 * EmptyState: friendly zero-results surface with an optional action.
 * Used by the catalog filters, archive, and any empty list.
 */
interface Props {
  title: string;
  body?: string;
  actionHref?: string;
  actionLabel?: string;
  class?: string;
}

const { title, body, actionHref, actionLabel, class: className } = Astro.props;
---

<div
  class={`flex flex-col items-center gap-3 rounded-lg border  border-border bg-surface-raised px-6 py-12 text-center ${className ?? ''}`}
>
  <span aria-hidden="true" class="text-5xl">🎉</span>
  <h2 class="font-display text-h4 text-ink">{title}</h2>
  {body && <p class="max-w-md text-body text-ink-muted">{body}</p>}
  {
    actionHref && actionLabel && (
      <a
        href={actionHref}
        class="mt-2 inline-flex min-h-11 items-center justify-center rounded-md bg-primary px-6 py-2.5 font-medium text-white  transition-colors hover:bg-primary-hover"
      >
        {actionLabel}
      </a>
    )
  }
</div>
