---
/**
 * BounceBox Chip (PRD §11).
 * filter: light coral fill, coral text, 2px coral border at 40% opacity.
 * status: severity-tinted pill (success/warning/error).
 */
interface Props {
  variant?: 'filter' | 'status';
  status?: 'success' | 'warning' | 'error';
  class?: string;
}

const { variant = 'filter', status = 'success', class: className } = Astro.props;

const statusClasses: Record<NonNullable<Props['status']>, string> = {
  success: 'bg-success-soft text-success-strong',
  warning: 'bg-warning-soft text-warning-strong',
  error: 'bg-danger-soft text-danger-strong',
};
---

<span
  class={`inline-flex items-center gap-1.5 rounded-md px-3.5 py-1.5 text-xs font-semibold ${
    variant === 'filter'
      ? 'border border-primary/40 bg-primary/15 text-primary-strong'
      : statusClasses[status]
  } ${className ?? ''}`}
>
  <slot />
</span>
