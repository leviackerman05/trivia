---
/**
 * LeaderboardTable: server-renderable rank rows (name + score). The host
 * player's row is highlighted and labeled "You". Empty rows fall back to
 * an EmptyState (callers decide). No JavaScript needed.
 */
interface Props {
  title: string;
  rows: { name: string; score: number }[];
  /** Player name to highlight (optional). */
  highlightName?: string;
  /** Footer note, e.g. "Resets daily at midnight UTC". */
  note?: string;
  class?: string;
}

const { title, rows, highlightName, note, class: className } = Astro.props;
---

<section aria-label={title} class={`flex flex-col gap-3 ${className ?? ''}`}>
  <h2 class="font-display text-h3 text-ink">{title}</h2>
  {
    rows.length === 0 ? (
      <p class="text-body text-ink-muted">No scores yet. Be the first on the board!</p>
    ) : (
      <ol class="flex flex-col gap-2">
        {rows.map((row, index) => {
          const isYou = row.name === highlightName;
          return (
            <li
              class:list={[
                'flex items-center justify-between gap-4 rounded-lg border-2 px-4 py-3',
                isYou ? 'border-primary bg-primary/10' : 'border-border bg-surface-raised',
              ]}
            >
              <span class="flex items-center gap-3">
                <span class="font-mono text-small font-semibold text-ink-muted">{index + 1}</span>
                <span class="font-semibold text-ink">{row.name}</span>
                {isYou && (
                  <span class="rounded-pill bg-primary/20 px-2 py-0.5 text-xs font-semibold text-primary-deep">
                    You
                  </span>
                )}
              </span>
              <span class="font-mono text-small font-semibold text-ink">{row.score}</span>
            </li>
          );
        })}
      </ol>
    )
  }
  {note && <p class="text-xs text-ink-muted">{note}</p>}
</section>
