---
/**
 * CategoryCard: discovery tile for a game family. One link, emoji glyph,
 * name, count, and a short pitch.
 */
interface Props {
  href: string;
  name: string;
  emoji: string;
  count: number;
  description: string;
  class?: string;
}

const { href, name, emoji, count, description, class: className } = Astro.props;
---

<a
  href={href}
  class={`group flex h-full flex-col gap-3 rounded-lg border-2 border-border bg-surface-raised p-6 shadow-sm transition-all duration-150 hover:-translate-y-0.5 hover:border-secondary hover:shadow-md ${className ?? ''}`}
>
  <span class="flex items-center justify-between gap-3">
    <span aria-hidden="true" class="text-4xl">{emoji}</span>
    <span class="rounded-pill bg-surface-muted px-3 py-1 text-xs font-semibold text-ink-muted">
      {count}
      {count === 1 ? 'game' : 'games'}
    </span>
  </span>
  <h2 class="font-display text-h3 text-ink group-hover:text-primary-strong">{name}</h2>
  <p class="text-body text-ink-muted">{description}</p>
</a>
