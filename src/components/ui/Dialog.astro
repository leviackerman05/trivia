---
/**
 * Dialog: accessible modal built on the native <dialog> element (focus trap,
 * Escape to close, inert backdrop all handled by the browser). The trigger
 * opens it via a tiny inline script. Title is announced on open.
 */
interface Props {
  id: string;
  title: string;
  /** "modal" traps focus and blocks background interaction (default). */
  mode?: 'modal' | 'non-modal';
  class?: string;
}

const { id, title, mode = 'modal', class: className } = Astro.props;
---

<dialog
  id={id}
  class="m-auto w-full max-w-lg rounded-lg border-2 border-border bg-surface-raised p-6 shadow-lg backdrop:bg-ink/50 backdrop:backdrop-blur-sm open:flex open:flex-col open:gap-4"
  aria-labelledby={`${id}-title`}
  aria-modal={mode === 'modal' ? 'true' : undefined}
>
  <div class="flex items-center justify-between gap-4">
    <h2 id={`${id}-title`} class="font-display text-h3 text-ink">
      {title}
    </h2>
    <button
      type="button"
      data-dialog-close={id}
      aria-label="Close dialog"
      class="inline-flex h-10 w-10 items-center justify-center rounded-pill border-2 border-border bg-surface-muted text-lg transition-colors hover:border-primary/50"
    >
      ✕
    </button>
  </div>
  <div class={className}>
    <slot />
  </div>
</dialog>

<script is:inline>
  (function () {
    const dialog = document.getElementById('{id}');
    if (!dialog) return;
    const closeButtons = dialog.querySelectorAll('[data-dialog-close]');
    function close() {
      dialog.close();
    }
    closeButtons.forEach((button) => button.addEventListener('click', close));
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) close();
    });
  })();
</script>
