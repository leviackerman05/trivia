---
import Badge from './ui/Badge.astro';
import type { DailyGame } from '../lib/daily';

/**
 * DailyCard: hub tile for one daily game. Live games get a play CTA;
 * planned games get a "coming soon" badge and a link to the solo game.
 */
interface Props {
  game: DailyGame;
}

const { game } = Astro.props;
---

<a
  href={game.live ? `/daily/${game.slug}` : `/game/${game.gameSlug}`}
  class="group flex h-full flex-col gap-3 rounded-lg border border-border bg-surface-raised p-4 sm:p-6 shadow-sm transition-all duration-150 hover:-translate-y-0.5 hover:border-primary/50 hover:shadow-md"
>
  <span class="flex items-start justify-between gap-3">
    <span aria-hidden="true" class="text-4xl">{game.emoji}</span>
    {game.live ? <Badge tone="success">Live</Badge> : <Badge tone="info">Coming soon</Badge>}
  </span>
  <h3 class="text-lg font-bold tracking-tight text-ink group-hover:text-primary-strong">{game.name}</h3>
  <p class="text-body text-ink-muted">{game.description}</p>
  <span class="mt-auto flex items-center gap-4 text-xs font-medium text-ink-muted">
    <span>⏱ {game.estimatedMinutes} min</span>
    <span class="rounded-pill bg-surface-muted px-3 py-1 font-semibold capitalize">
      {game.category}
    </span>
  </span>
</a>
