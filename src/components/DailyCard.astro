---
import Badge from './ui/Badge.astro';
import Icon from './icons/Icon.astro';
import type { DailyGame } from '../lib/daily';

/**
 * DailyCard: hub tile for one daily game. Live games get a play CTA;
 * planned games get a "coming soon" badge and a link to the solo game.
 * [§5.3] Airbnb hover (1px border + single hover-float, no translate);
 * the registry `emoji` field holds in-repo icon keys, rendered via Icon.
 */
interface Props {
  game: DailyGame;
}

const { game } = Astro.props;
---

<a
  href={game.live ? `/daily/${game.slug}` : `/game/${game.gameSlug}`}
  class="group flex h-full flex-col gap-3 rounded-lg border border-border bg-surface-raised p-4 shadow-sm transition-shadow duration-150 hover:shadow-md sm:p-6"
>
  <span class="flex items-start justify-between gap-3">
    <span aria-hidden="true" class="text-ink-muted">
      <Icon name={game.emoji} size={32} strokeWidth={1.5} />
    </span>
    {game.live ? <Badge tone="success">Live</Badge> : <Badge tone="info">Coming soon</Badge>}
  </span>
  <h3 class="text-base font-semibold text-ink group-hover:text-primary-strong">
    {game.name}
  </h3>
  <p class="text-body text-ink-muted">{game.description}</p>
  <span class="mt-auto flex items-center gap-4 text-xs font-medium text-ink-muted">
    <span class="inline-flex items-center gap-1">
      {game.estimatedMinutes} min
    </span>
    <span class="rounded-pill bg-surface-muted px-3 py-1 font-semibold capitalize">
      {game.category}
    </span>
  </span>
</a>
