---
/**
 * BounceBox FAQ accordion, CSS-only (PRD §13: no heavy animation libs).
 * Uses <details>/<summary> for native keyboard + screen-reader support;
 * the + icon rotates on open via a CSS transition.
 */
interface Props {
  items: { question: string; answer: string }[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<div class={`flex flex-col gap-3 ${className ?? ''}`}>
  {
    items.map((item) => (
      <details class="group rounded-lg border border-border bg-surface-raised p-4 shadow-sm transition-colors open:border-primary/50 open:shadow-md sm:p-6">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold text-ink [&::-webkit-details-marker]:hidden">
          {item.question}
          <span
            aria-hidden="true"
            class="grid size-8 shrink-0 place-items-center rounded-md bg-primary/20 text-primary-strong transition-transform duration-200 group-open:rotate-45"
          >
            +
          </span>
        </summary>
        <p class="mt-3 text-small text-ink-muted">{item.answer}</p>
      </details>
    ))
  }
</div>
