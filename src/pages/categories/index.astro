---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryCard from '../../components/ui/CategoryCard.astro';
import { games, type GameFamily } from '../../lib/games';

const families: { family: GameFamily; name: string; icon: string; description: string }[] = [
  {
    family: 'drawing',
    name: 'Drawing Games',
    icon: 'pencil',
    description: 'Sketch, guess, and laugh. Pictionary-style rooms with custom word lists.',
  },
  {
    family: 'party',
    name: 'Party Classics',
    icon: 'confetti',
    description: 'Charades, Guess Who, and live percentage battles for big groups.',
  },
  {
    family: 'solo',
    name: 'Solo Games',
    icon: 'user',
    description: 'Word puzzles, trivia, and brain teasers with daily streaks and leaderboards.',
  },
  {
    family: 'quiz',
    name: 'Quiz Games',
    icon: 'question',
    description: 'Ten categories, 525 questions, solo dailies or a room-wide race.',
  },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://playtriviahub.com/' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Categories',
      item: 'https://playtriviahub.com/categories',
    },
  ],
});
---

<BaseLayout
  title="Game Categories: Drawing, Party, Solo and Quiz | Trivia & Games"
  description="Browse Trivia & Games by category: drawing games, party classics, trivia and quiz games, solo puzzles, and word games. Free to play, no downloads, no accounts."
  canonicalPath="/categories"
  jsonLd={jsonLd}
  activeNav="categories"
>
  <section class="mb-10">
    <h1 class="font-display text-h1 text-ink">Browse by category</h1>
    <p class="mt-4 max-w-2xl text-body text-ink-muted">
      Every Trivia & Games game fits one of four families. Pick a mood, find your game, and start
      playing in seconds.
    </p>
  </section>

  <section aria-label="Game categories">
    <ul class="grid gap-4 sm:gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        families.map((family) => {
          const count = games.filter((game) => game.family === family.family).length;
          return (
            <li>
              <CategoryCard
                href={`/#games-${family.family}`}
                name={family.name}
                icon={family.icon}
                count={count}
                description={family.description}
              />
            </li>
          );
        })
      }
    </ul>
  </section>

  <section aria-label="Quick links" class="mt-14">
    <h2 class="mb-5 font-display text-h2 text-ink">Quick links</h2>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <li>
        <a
          href="/daily"
          class="block rounded-lg border border-border bg-surface-raised p-5 text-body font-semibold text-ink transition-colors hover:border-primary/50 hover:text-primary-strong"
        >
          Daily Games: today's trivia and sudoku →
        </a>
      </li>
      <li>
        <a
          href="/game/trivia"
          class="block rounded-lg border border-border bg-surface-raised p-5 text-body font-semibold text-ink transition-colors hover:border-primary/50 hover:text-primary-strong"
        >
          Trivia: solo daily or room race →
        </a>
      </li>
      <li>
        <a
          href="/game/skribbl-arena"
          class="block rounded-lg border border-border bg-surface-raised p-5 text-body font-semibold text-ink transition-colors hover:border-primary/50 hover:text-primary-strong"
        >
          Skribbl Arena: drawing rooms up to 24 players →
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>
