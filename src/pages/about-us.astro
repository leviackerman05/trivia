---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/ui/Card.astro';
---

<BaseLayout
  title="About Us — PartyBrain"
  description="What PartyBrain is, who built it, and why it exists: 18 free party games that anyone can play with friends in seconds."
  canonicalPath="/about-us"
>
  <section class="max-w-3xl">
    <h1 class="mb-8 font-display text-h1 text-ink">About PartyBrain</h1>
    <div class="flex flex-col gap-5">
      <Card hover={false}>
        <p class="text-body text-ink-muted">
          PartyBrain is a free online party games hub featuring 18 multiplayer and solo games —
          drawing games, trivia, word games, voting games, charades, and more.
        </p>
      </Card>
      <Card hover={false}>
        <p class="text-body text-ink-muted">
          Our goal is simple: a party game should start in seconds, not after a download, an
          account, and a tutorial. Open a game, share a link, and play — whether you’re in the same
          room or on different continents.
        </p>
      </Card>
      <Card hover={false}>
        <p class="text-body text-ink-muted">
          We built PartyBrain for virtual parties, classroom icebreakers, remote teams, and
          streamers looking for games their audience can play along with. Every game is free,
          mobile-friendly, and designed to be fun for groups of all sizes.
        </p>
      </Card>
    </div>
  </section>
</BaseLayout>
