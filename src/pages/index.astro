---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCard from '../components/GameCard.astro';
import Button from '../components/ui/Button.astro';
import Chip from '../components/ui/Chip.astro';
import FAQSection from '../components/FAQSection.astro';
import { games, type GameFamily } from '../lib/games';
import { globalFaqs } from '../data/faqs';

const familySections: { family: GameFamily; label: string }[] = [
  { family: 'drawing', label: 'Drawing Games' },
  { family: 'voting', label: 'Voting Games' },
  { family: 'solo', label: 'Solo Games' },
  { family: 'special', label: 'Party Classics' },
  { family: 'quiz', label: 'Quiz' },
];

const valueProps = [
  {
    title: 'No downloads',
    body: 'Every game runs right in your browser. Nothing to install, nothing to update.',
  },
  {
    title: 'No accounts',
    body: 'Pick a nickname and play. One link is all your friends need to join.',
  },
  {
    title: 'Any device',
    body: 'Phones, tablets, laptops — games are built mobile-first with touch in mind.',
  },
];

// PRD §6.1/§6.3 — FAQPage JSON-LD on the homepage.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: globalFaqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
});
---

<BaseLayout
  title="Free Online Party Games | Play with Friends Instantly | PartyBrain"
  description="Play 18 free online party games with friends — no downloads, no accounts. Drawing games, trivia, word games, and more. Perfect for virtual parties, classrooms, and team building. Start playing in seconds!"
  canonicalPath="/"
  ogImage="/og/home.png"
  jsonLd={jsonLd}
>
  <section class="mb-14 text-center">
    <Chip variant="status" status="success" class="mb-6"
      >18 free games · no downloads · no accounts</Chip
    >
    <h1 class="font-display text-h1 text-ink">
      Free Online Party Games — Play Instantly with Friends
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-body text-ink-muted">
      Drawing games, trivia, word games, voting games, charades and more. Share a room link and
      start playing in seconds — perfect for virtual parties, classrooms, and remote teams.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <Button variant="primary" size="large" href="/#games">Browse all games</Button>
      <Button variant="ghost" size="large" href="/faq">How it works</Button>
    </div>
  </section>

  <section aria-label="Why PartyBrain" class="mb-14 grid gap-6 sm:grid-cols-3">
    {
      valueProps.map(({ title, body }) => (
        <article class="rounded-lg border-2 border-gray-200 bg-white p-6 shadow-sm">
          <h2 class="mb-2 font-display text-h4 text-ink">{title}</h2>
          <p class="text-body text-ink-muted">{body}</p>
        </article>
      ))
    }
  </section>

  <section id="games" aria-label="All PartyBrain games">
    {
      familySections.map(({ family, label }) => {
        const familyGames = games.filter((game) => game.family === family);
        return (
          <div class="mb-12">
            <h2 class="mb-5 font-display text-h2 text-ink">{label}</h2>
            <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {familyGames.map((game) => (
                <li>
                  <GameCard game={game} />
                </li>
              ))}
            </ul>
          </div>
        );
      })
    }
  </section>

  <!-- PRD §6.1 — ~600-word keyword-rich content with internal links. -->
  <section aria-label="About PartyBrain games" class="flex flex-col gap-6">
    <h2 class="font-display text-h2 text-ink">
      The best free online party games, right in your browser
    </h2>
    <p class="max-w-3xl text-body text-ink-muted">
      PartyBrain is a collection of 18 free online party games designed for the way people actually
      play today: across devices, across time zones, and without any setup. Every game runs directly
      in the browser — there are no downloads, no accounts, and no plugins. If you and your friends
      can open a link, you can play. That makes PartyBrain the easiest <strong
        >browser party games</strong
      > destination for virtual parties, classrooms, remote teams, and family game nights.
    </p>
    <p class="max-w-3xl text-body text-ink-muted">
      The heart of the site is the drawing room. If you are looking to{' '}
      <strong>play pictionary online</strong> with friends, start with{' '}
      <a href="/game/skribbl-arena" class="font-semibold text-primary-strong underline"
        >Skribbl Arena</a
      >, our fast multiplayer drawing game where one player sketches a secret word and everyone
      races to guess it. It is a genuine <strong>skribbl alternative</strong>: free, modern, and
      full of extras like custom word lists, fill tools, and solo practice mode. The drawing family
      continues with{' '}
      <a href="/game/copycat-challenge" class="font-semibold text-primary-strong underline"
        >Copycat Challenge</a
      >, where you memorize a famous painting for five seconds and redraw it from memory, and{' '}
      <a href="/game/one-line-one-shape" class="font-semibold text-primary-strong underline"
        >One Line, One Shape</a
      >, the continuous-line challenge that punishes every pen lift. For something gentler,{' '}
      <a href="/game/shadow-sketch" class="font-semibold text-primary-strong underline"
        >Shadow Sketch</a
      >{' '}
      asks you to fill in a silhouette while guessers watch the details appear, and{' '}
      <a href="/game/draw-the-lyric" class="font-semibold text-primary-strong underline"
        >Draw the Lyric</a
      >{' '}
      turns song lyrics into a title-guessing race.
    </p>
    <p class="max-w-3xl text-body text-ink-muted">
      Not a drawer? The voting games are built for big rooms and loud arguments.{' '}
      <a href="/game/would-you-rather" class="font-semibold text-primary-strong underline"
        >Would You Rather online</a
      >{' '}
      turns outrageous dilemmas into live percentage battles, while{' '}
      <a href="/game/most-likely-to" class="font-semibold text-primary-strong underline"
        >Most Likely To…</a
      >{' '}
      puts your friends on trial and crowns the most likely culprit.{' '}
      <a href="/game/never-have-i-ever" class="font-semibold text-primary-strong underline"
        >Never Have I Ever</a
      >{' '}
      scores the wildness of the room, and{' '}
      <a href="/game/this-or-that" class="font-semibold text-primary-strong underline"
        >This or That</a
      >{' '}
      delivers 20 rapid-fire taste battles in two minutes. Every voting game updates percentages live,
      so the whole room watches the numbers swing.
    </p>
    <p class="max-w-3xl text-body text-ink-muted">
      For trivia nights, our <strong>online trivia games</strong> cover General, Science, History, Pop
      Culture, and Sports. Play the daily challenge solo or race the room in{' '}
      <a href="/game/trivia" class="font-semibold text-primary-strong underline">Trivia</a>, with a
      Wrong Answers Only comedy mode for maximum chaos. Solo players can also test their word skills
      in <a href="/game/rhyme-or-crime" class="font-semibold text-primary-strong underline"
        >Rhyme or Crime</a
      >, decode movie plots in{' '}
      <a href="/game/emoji-plot" class="font-semibold text-primary-strong underline">Emoji Plot</a>,
      order history in{' '}
      <a href="/game/timeline-tussle" class="font-semibold text-primary-strong underline"
        >Timeline Tussle</a
      >, and guess real prices in{' '}
      <a href="/game/price-is-right" class="font-semibold text-primary-strong underline"
        >Price Is Right</a
      >. Film buffs get <a
        href="/game/genre-swap"
        class="font-semibold text-primary-strong underline">Genre Swap</a
      >{' '}
      and <a href="/game/genre-bender" class="font-semibold text-primary-strong underline"
        >Genre-Bender</a
      >, and the classics return in{' '}
      <a href="/game/charades" class="font-semibold text-primary-strong underline">Charades</a>{' '}
      and{' '}
      <a href="/game/guess-who" class="font-semibold text-primary-strong underline"
        >Guess Who? Celebrity Edition</a
      >.
    </p>
    <p class="max-w-3xl text-body text-ink-muted">
      Every multiplayer game uses a simple room system: create a room, share the code or link, and
      play. Rooms support up to 24 players, and everything is optimized for phones, tablets, and
      desktops, so <strong>virtual party games</strong> feel as natural as passing the phone around a
      couch. Whether you are hosting a video-call game night, running a classroom warm-up, or building
      team morale remotely, PartyBrain gets a game started in seconds — free, forever.
    </p>
  </section>

  <section aria-label="Frequently asked questions" class="flex flex-col gap-4">
    <h2 class="font-display text-h2 text-ink">Frequently Asked Questions</h2>
    <FAQSection items={globalFaqs} class="max-w-3xl" />
  </section>
</BaseLayout>
