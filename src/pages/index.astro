---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCard from '../components/GameCard.astro';
import DailyCard from '../components/DailyCard.astro';
import Button from '../components/ui/Button.astro';
import Chip from '../components/ui/Chip.astro';
import RecentlyPlayed from '../islands/RecentlyPlayed.tsx';
import { games, type GameFamily } from '../lib/games';
import { getLiveDailyGames } from '../lib/daily';
import { globalFaqs } from '../data/faqs';

// [R3] voting + special merged into party; chrome icons are in-repo SVGs.
const familySections: { family: GameFamily; label: string; icon: string }[] = [
  { family: 'drawing', label: 'Drawing Games', icon: 'pencil' },
  { family: 'party', label: 'Party Games', icon: 'confetti' },
  { family: 'solo', label: 'Solo Games', icon: 'user' },
  { family: 'quiz', label: 'Quiz', icon: 'question' },
];

const liveDaily = getLiveDailyGames();
const trending = [...games].sort((a, b) => (b.popularity ?? 0) - (a.popularity ?? 0)).slice(0, 6);
const newGames = games.filter((game) => game.isNew);
const multiplayerGames = games.filter((game) => game.type !== 'solo');

// PRD §6.1/§6.3, FAQPage JSON-LD on the homepage. The homepage only needs
// a summary; the /faq page carries the full 9-question list (globalFaqs).
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: globalFaqs.slice(0, 5).map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
});
---

<BaseLayout
  title="Trivia in Games: Free Party Games, Daily Trivia and Multiplayer Fun"
  description="Play 20 free online party games with friends, no downloads and no accounts. Daily trivia and sudoku, drawing games, party classics, and multiplayer rooms. Start playing in seconds!"
  canonicalPath="/"
  ogImage="/og/home.png"
  jsonLd={jsonLd}
  activeNav="home"
>
  <section class="mb-14 text-center">
    <Chip variant="status" status="success" class="mb-6"
      >20 free games · daily challenges · play in seconds</Chip
    >
    <h1 class="mx-auto max-w-4xl font-display text-h1 font-bold tracking-tight text-ink">
      Best daily trivia and party games
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-body text-ink-muted">
      Play the same daily trivia as everyone else, race friends in drawing and voting rooms, and
      build a streak worth protecting. Free, in your browser.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <Button variant="primary" size="large" href="/daily">Play today's daily</Button>
      <Button variant="ghost" size="large" href="/#games">Browse all games</Button>
    </div>
  </section>

  <section aria-label="Daily games" class="mb-14">
    <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
      <h2 class="font-display text-h2 text-ink">Today at Trivia in Games</h2>
      <a href="/daily" class="text-small font-semibold text-primary-strong hover:underline">
        All daily games →
      </a>
    </div>
    <ul class="grid gap-4 sm:gap-6 sm:grid-cols-2">
      {
        liveDaily.slice(0, 3).map((game) => (
          <li>
            <DailyCard game={game} />
          </li>
        ))
      }
    </ul>
  </section>

  <section id="trending" aria-label="Trending games" class="mb-14 scroll-mt-24">
    <h2 class="mb-5 font-display text-h2 text-ink">Trending now</h2>
    <ul class="grid gap-3 sm:grid-cols-2">
      {
        trending.map((game, index) => (
          <li>
            <a href={`/game/${game.slug}`} class="pb-row-link">
              <span class="font-display text-h3 text-primary-deep">{index + 1}</span>
              <span class="min-w-0">
                <span class="block truncate font-semibold text-ink">{game.name}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="multiplayer" aria-label="Multiplayer games" class="mb-14 scroll-mt-24">
    <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 class="font-display text-h2 text-ink">Multiplayer rooms</h2>
        <p class="mt-2 max-w-2xl text-body text-ink-muted">
          Create a room, share the code, friends jump in from any device, up to 24 players.
        </p>
      </div>
      <a href="/#games" class="text-small font-semibold text-primary-strong hover:underline">
        All games →
      </a>
    </div>
    <ul class="grid gap-3 sm:grid-cols-2">
      {
        multiplayerGames.slice(0, 6).map((game) => (
          <li>
            <a href={`/game/${game.slug}`} class="pb-row-link">
              <span class="min-w-0">
                <span class="block truncate font-semibold text-ink">{game.name}</span>
                <span class="block truncate text-xs text-ink-muted">{game.tagline}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="new-games" aria-label="New games" class="mb-14 scroll-mt-24">
    <h2 class="mb-5 font-display text-h2 text-ink">New games</h2>
    {
      newGames.length > 0 ? (
        <ul class="flex flex-wrap gap-3">
          {newGames.map((game) => (
            <li>
              <a href={`/game/${game.slug}`} class="pb-chip-link">
                {game.name} →
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-body text-ink-muted">Fresh games land here. Check back soon.</p>
      )
    }
  </section>

  <section id="recently-played" aria-label="Recently played" class="mb-14 scroll-mt-24">
    <h2 class="mb-5 font-display text-h2 text-ink">Recently played</h2>
    <RecentlyPlayed client:load />
  </section>

  <section id="games" class="mb-14 scroll-mt-24">
    {
      familySections.map(({ family, label }) => {
        const familyGames = games.filter((game) => game.family === family);
        return (
          <div id={`games-${family}`} class="mb-12 scroll-mt-24">
            <h2 class="mb-5 font-display text-h2 text-ink">{label}</h2>
            <ul class="grid gap-4 sm:gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {familyGames.map((game) => (
                <li>
                  <GameCard game={game} />
                </li>
              ))}
            </ul>
          </div>
        );
      })
    }
  </section>

  <!-- PRD §6.1, ~600-word keyword-rich content with internal links. -->
  <section aria-label="About Trivia in Games games" class="flex flex-col gap-4 sm:gap-6">
    <h2 class="font-display text-h2 text-ink">
      The best free online party games, right in your browser
    </h2>
    <p class="max-w-3xl text-body text-ink-muted">
      Trivia in Games is a collection of 20 free online party games designed for the way people play
      today: across devices, across time zones, and without any setup. Every game runs in the
      browser, no downloads, no accounts. If you can open a link, you can play, which makes it the
      easiest <strong>browser party games</strong> destination for virtual parties, classrooms, remote
      teams, and family game nights.
    </p>
    <p class="max-w-3xl text-body text-ink-muted">
      The heart of the site is the drawing room. Looking to <strong>play pictionary online</strong>?
      Start with{' '}
      <a href="/game/skribbl-arena" class="font-semibold text-primary-strong underline"
        >Skribbl Arena</a
      >, a fast multiplayer drawing game where one player sketches and everyone races to guess. The
      drawing family continues with{' '}
      <a href="/game/copycat-challenge" class="font-semibold text-primary-strong underline"
        >Copycat Challenge</a
      >,{' '}
      <a href="/game/one-line-one-shape" class="font-semibold text-primary-strong underline"
        >One Line, One Shape</a
      >,{' '}
      <a href="/game/shadow-sketch" class="font-semibold text-primary-strong underline"
        >Shadow Sketch</a
      >, and{' '}
      <a href="/game/draw-the-lyric" class="font-semibold text-primary-strong underline"
        >Draw the Lyric</a
      >.
    </p>
    <p class="max-w-3xl text-body text-ink-muted">
      Not a drawer? Party games are built for big rooms and loud arguments.{' '}
      <a href="/game/would-you-rather" class="font-semibold text-primary-strong underline"
        >Would You Rather online</a
      >{' '}
      turns wild dilemmas into live percentage battles,{' '}
      <a href="/game/most-likely-to" class="font-semibold text-primary-strong underline"
        >Most Likely To</a
      >{' '}
      crowns the most likely culprit,{' '}
      <a href="/game/never-have-i-ever" class="font-semibold text-primary-strong underline"
        >Never Have I Ever</a
      >{' '}
      scores the room's wildness, and{' '}
      <a href="/game/this-or-that" class="font-semibold text-primary-strong underline"
        >This or That</a
      >{' '}
      delivers rapid-fire taste battles, with{' '}
      <a href="/game/charades" class="font-semibold text-primary-strong underline">Charades</a>{' '}
      and{' '}
      <a href="/game/guess-who" class="font-semibold text-primary-strong underline"
        >Guess Who? Celebrity Edition</a
      >{' '}
      rounding out the classics.
    </p>
    <p class="max-w-3xl text-body text-ink-muted">
      For trivia nights, our <strong>online trivia games</strong> cover General, Science, History, Pop
      Culture, and Sports. Play the daily challenge solo or race the room in{' '}
      <a href="/game/trivia" class="font-semibold text-primary-strong underline">Trivia</a>. Solo
      players can test their word skills in{' '}
      <a href="/game/rhyme-or-crime" class="font-semibold text-primary-strong underline"
        >Rhyme or Crime</a
      >, decode movie plots in{' '}
      <a href="/game/emoji-plot" class="font-semibold text-primary-strong underline">Emoji Plot</a>,
      order history in{' '}
      <a href="/game/timeline-tussle" class="font-semibold text-primary-strong underline"
        >Timeline Tussle</a
      >, guess real prices in{' '}
      <a href="/game/price-is-right" class="font-semibold text-primary-strong underline"
        >Price Is Right</a
      >, swap genres in{' '}
      <a href="/game/genre-swap" class="font-semibold text-primary-strong underline">Genre Swap</a>,
      and test their geography instincts in{' '}
      <a href="/game/world-peek" class="font-semibold text-primary-strong underline">World Peek</a>.
    </p>
    <p class="max-w-3xl text-body text-ink-muted">
      Every multiplayer game uses a simple room system: create a room, share the code or link, and
      play. Rooms hold up to 24 players on phones, tablets, and desktops. And when the night is
      over, tomorrow's <a href="/daily" class="font-semibold text-primary-strong underline"
        >daily games</a
      > are already waiting.
    </p>
  </section>

  <section
    aria-label="Frequently asked questions"
    class="flex flex-wrap items-center justify-between gap-4 rounded-lg border border-border bg-surface-raised p-4 sm:p-6"
  >
    <div class="min-w-0">
      <h2 class="text-lg font-bold tracking-tight text-ink">Frequently Asked Questions</h2>
      <p class="mt-1 text-small text-ink-muted">
        How to host, join, score, and play every game, answered.
      </p>
    </div>
    <a
      href="/faq"
      class="inline-flex min-h-11 items-center justify-center rounded-md bg-primary px-5 text-small font-semibold text-white transition-colors hover:bg-primary-hover"
    >
      Visit the FAQ
    </a>
  </section>
</BaseLayout>
