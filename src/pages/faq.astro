---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQSection from '../components/FAQSection.astro';
import { globalFaqs } from '../data/faqs';

// PRD §6.3, FAQPage structured data for the global FAQ.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: globalFaqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
});
---

<BaseLayout
  title="FAQ | TriviaHub"
  description="Answers to the most common questions about TriviaHub: how to play with friends, whether you need an account, which games work for large groups, and more."
  canonicalPath="/faq"
  jsonLd={jsonLd}
>
  <section>
    <h1 class="mb-2 font-display text-h1 text-ink">Frequently Asked Questions</h1>
    <p class="mb-8 max-w-2xl text-body text-ink-muted">
      Everything you need to know about playing TriviaHub with friends.
    </p>
    <FAQSection items={globalFaqs} class="max-w-3xl" />
  </section>
</BaseLayout>
