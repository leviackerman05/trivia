---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="Something Went Wrong | TriviaHub"
  description="TriviaHub hit an unexpected error. Please try again in a moment."
  canonicalPath="/500"
>
  <section class="flex flex-col items-center gap-4 py-16 text-center">
    <p class="font-display text-8xl text-primary-strong">500</p>
    <h1 class="font-display text-h2 text-ink">Something went wrong</h1>
    <p class="max-w-md text-body text-ink-muted">
      An unexpected error occurred. Please try again in a moment, your games will still be here.
    </p>
    <Button variant="primary" size="large" href="/">Back to TriviaHub</Button>
  </section>
</BaseLayout>
