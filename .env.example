# Frontend environment template. Copy to .env for local development.
# Backend base URL (Express + Socket.io) the islands talk to.
PUBLIC_SERVER_URL=http://localhost:3000
# World Peek panoramas (D062): free client token from
# mapillary.com/dashboard/developers. MAPILLARY_TOKEN drives the build-time
# resolver (scripts/resolve-world-peek-panos.mjs); PUBLIC_MAPILLARY_TOKEN
# is inlined into the client for the mapillary-js viewer. Set both to the
# same value.
MAPILLARY_TOKEN=
PUBLIC_MAPILLARY_TOKEN=
