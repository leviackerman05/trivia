# Server environment template. Copy to .env for local development
# (real values live in the platform secret store for production).

# Node
PORT=3000
LOG_LEVEL=info

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://triviahub:triviahub@localhost:5432/triviahub

# Comma-separated list of allowed browser origins.
# Empty = allow all origins (local development only). Set for production.
CORS_ORIGIN=http://localhost:4321
