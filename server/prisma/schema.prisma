// TriviaHub database schema, PRD §8.3 models kept verbatim.
// Additive changes only (indexes/constraints) per DECISIONS D006.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Game {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  type      String // "solo" | "multiplayer-realtime" | "multiplayer-voting"
  createdAt DateTime @default(now())
}

model Room {
  id        String       @id @default(cuid())
  code      String       @unique
  gameId    String
  status    String       @default("lobby") // lobby, in-progress, finished
  createdAt DateTime     @default(now())
  players   RoomPlayer[]
}

model RoomPlayer {
  id         String   @id @default(cuid())
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id])
  playerName String
  joinedAt   DateTime @default(now())

  // Additive: one seat per name per room (rejoin/replace upserts, M3)
  @@unique([roomId, playerName])
}

model Score {
  id         String   @id @default(cuid())
  gameId     String
  playerName String
  score      Int
  playedAt   DateTime @default(now())

  // Additive: idempotent score submission (client-generated key, M3)
  clientKey String? @unique

  // Additive: leaderboard queries (gameId + period, gameId + top-N)
  @@index([gameId, playedAt])
  @@index([gameId, score])
}

model DailyChallenge {
  id     String   @id @default(cuid())
  gameId String
  date   DateTime
  data   Json

  // Additive: one challenge per game per day (upsert-safe rollover)
  @@unique([gameId, date])
}

// Phase 1.5 (D047-D049): account-lite identity + server-side streaks.
// A member is a browser with a device-generated memberKey; no passwords,
// no email. The Score table remains the leaderboard source for guests and
// members alike; DailyRun is the identity/history/personal-best layer.

model UserProfile {
  id               String        @id @default(cuid())
  memberKey        String        @unique
  nickname         String        @default("Player")
  email            String? // reserved for future recovery/recap (D047)
  xp               Int           @default(0)
  level            Int           @default(1)
  streakFreezes    Int           @default(0)
  restoreUsedSeason String? // e.g. "2026-Q3", one mercy restore per season
  createdAt        DateTime      @default(now())
  lastSeenAt       DateTime      @default(now())
  dailyRuns        DailyRun[]
  streaks          DailyStreak[]

  @@index([lastSeenAt])
}

model DailyRun {
  id           String      @id @default(cuid())
  userId       String
  user         UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId       String
  dateKey      String // UTC day "YYYY-MM-DD" (matches client dailyDateKey)
  tier         String      @default("normal")
  score        Int
  durationMs   Int         @default(0)
  correctCount Int         @default(0)
  totalCount   Int         @default(0)
  clientKey    String      @unique
  createdAt    DateTime    @default(now())

  // One run per member per game per day; replays are idempotent no-ops.
  @@unique([userId, gameId, dateKey])
  @@index([gameId, dateKey])
  @@index([userId, dateKey])
}

model DailyStreak {
  id       String      @id @default(cuid())
  userId   String
  user     UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope    String // "grand" or a daily game slug
  current  Int         @default(0)
  longest  Int         @default(0)
  lastDate String      @default("")
  updatedAt DateTime   @updatedAt

  @@unique([userId, scope])
}

// M19 drawing gallery (DAILY-DESIGN §6, additive): the first server-persisted
// user content. Rows are the source of truth for votes/flags; the counters on
// the submission are denormalized for cheap top-50 reads and the 3-flag check.
// One submission per member per UTC day (idempotent uploads, D049 pattern).

model DrawingSubmission {
  id          String    @id @default(cuid())
  dateKey     String // UTC "YYYY-MM-DD" (matches dailyDateKey)
  promptIndex Int
  memberKey   String // device memberKey (D047); not a credential
  playerName  String // sanitized, ≤20 chars (sanitizeNickname)
  image       String // PNG data URL, ≤1 MB decoded; client downscales to ≤1024 px
  votes       Int       @default(0) // denormalized; derives from DrawingVote rows
  flagCount   Int       @default(0) // denormalized; derives from DrawingFlag rows
  status      String    @default("visible") // visible | flagged | removed
  createdAt   DateTime  @default(now())

  voteRows    DrawingVote[]
  flagRows    DrawingFlag[]

  // One submission per member per day — idempotent uploads (D049 pattern).
  @@unique([dateKey, memberKey])
  // Gallery query: (dateKey, visible) filtered, ordered by votes desc.
  // votes included in the index per ARCHITECTURE §11 implementation notes.
  @@index([dateKey, status, votes])
}

model DrawingVote {
  id           String            @id @default(cuid())
  submissionId String
  submission   DrawingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  memberKey    String
  createdAt    DateTime          @default(now())

  @@unique([submissionId, memberKey]) // one vote per member per submission (R1)
  @@index([memberKey]) // votedByMe lookups for the gallery read
}

model DrawingFlag {
  id           String            @id @default(cuid())
  submissionId String
  submission   DrawingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  memberKey    String
  reason       String? // sanitized, ≤200 chars
  createdAt    DateTime          @default(now())

  @@unique([submissionId, memberKey]) // one flag per member per submission (R1)
  @@index([submissionId])
}
