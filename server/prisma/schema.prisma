// TriviaHub database schema, PRD §8.3 models kept verbatim.
// Additive changes only (indexes/constraints) per DECISIONS D006.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Game {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  type      String // "solo" | "multiplayer-realtime" | "multiplayer-voting"
  createdAt DateTime @default(now())
}

model Room {
  id        String       @id @default(cuid())
  code      String       @unique
  gameId    String
  status    String       @default("lobby") // lobby, in-progress, finished
  createdAt DateTime     @default(now())
  players   RoomPlayer[]
}

model RoomPlayer {
  id         String   @id @default(cuid())
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id])
  playerName String
  joinedAt   DateTime @default(now())

  // Additive: one seat per name per room (rejoin/replace upserts, M3)
  @@unique([roomId, playerName])
}

model Score {
  id         String   @id @default(cuid())
  gameId     String
  playerName String
  score      Int
  playedAt   DateTime @default(now())

  // Additive: idempotent score submission (client-generated key, M3)
  clientKey String? @unique

  // Additive: leaderboard queries (gameId + period, gameId + top-N)
  @@index([gameId, playedAt])
  @@index([gameId, score])
}

model DailyChallenge {
  id     String   @id @default(cuid())
  gameId String
  date   DateTime
  data   Json

  // Additive: one challenge per game per day (upsert-safe rollover)
  @@unique([gameId, date])
}

// Phase 1.5 (D047-D049): account-lite identity + server-side streaks.
// A member is a browser with a device-generated memberKey; no passwords,
// no email. The Score table remains the leaderboard source for guests and
// members alike; DailyRun is the identity/history/personal-best layer.

model UserProfile {
  id               String        @id @default(cuid())
  memberKey        String        @unique
  nickname         String        @default("Player")
  email            String? // reserved for future recovery/recap (D047)
  xp               Int           @default(0)
  level            Int           @default(1)
  streakFreezes    Int           @default(0)
  restoreUsedSeason String? // e.g. "2026-Q3", one mercy restore per season
  createdAt        DateTime      @default(now())
  lastSeenAt       DateTime      @default(now())
  dailyRuns        DailyRun[]
  streaks          DailyStreak[]

  @@index([lastSeenAt])
}

model DailyRun {
  id           String      @id @default(cuid())
  userId       String
  user         UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId       String
  dateKey      String // UTC day "YYYY-MM-DD" (matches client dailyDateKey)
  tier         String      @default("normal")
  score        Int
  durationMs   Int         @default(0)
  correctCount Int         @default(0)
  totalCount   Int         @default(0)
  clientKey    String      @unique
  createdAt    DateTime    @default(now())

  // One run per member per game per day; replays are idempotent no-ops.
  @@unique([userId, gameId, dateKey])
  @@index([gameId, dateKey])
  @@index([userId, dateKey])
}

model DailyStreak {
  id       String      @id @default(cuid())
  userId   String
  user     UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope    String // "grand" or a daily game slug
  current  Int         @default(0)
  longest  Int         @default(0)
  lastDate String      @default("")
  updatedAt DateTime   @updatedAt

  @@unique([userId, scope])
}
